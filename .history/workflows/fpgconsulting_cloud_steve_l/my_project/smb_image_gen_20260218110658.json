    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1-a",
              "name": "poster_concept",
              "value": "={{ $json.body.poster_concept }}",
              "type": "object"
            },
            {
              "id": "s1-b",
              "name": "guidelines",
              "value": "={{ $json.body.guidelines }}",
              "type": "object"
            },
            {
              "id": "s1-c",
              "name": "image_urls",
              "value": "={{ $json.body.image_urls }}",
              "type": "array"
            },
            {
              "id": "s1-d",
              "name": "image_selection_system",
              "value": "You are an expert OOH (Out-of-Home) Creative Image Curator for UK SMB advertising. Your job is to select the best images from a provided list of candidate image URLs to support ONE specific poster concept.\n\nReturn ONLY valid JSON with no markdown or extra text.\n\nJSON schema:\n{\n  \"selected_images\": [\"url1\", \"url2\", ...],\n  \"selection_notes\": {\n    \"concept_name\": \"string\",\n    \"vertical\": \"string\",\n    \"top_reasons\": [\"string\"]\n  }\n}",
              "type": "string"
            },
            {
              "id": "s1-e",
              "name": "image_selection_user_template",
              "value": "Select 5-6 best OOH poster images from this list:\n\nConcept: {poster_concept}\nGuidelines: {guidelines}\nAvailable URLs: {image_urls}\n\nReturn ONLY JSON matching the schema. No markdown. No extra text.",
              "type": "string"
            },
            {
              "id": "s1-f",
              "name": "poster_gen_system",
              "value": "You are an expert UK OOH poster art director. Your job is to generate a detailed DALL·E-ready prompt for a professional poster.\n\nReturn ONLY valid JSON with no markdown or extra text.\n\nJSON schema:\n{\n  \"poster_name\": \"string\",\n  \"poster_prompt\": \"string (detailed prompt for DALL-E)\",\n  \"layout_spec\": {\n    \"format\": \"6-sheet|48-sheet\",\n    \"orientation\": \"portrait|landscape\",\n    \"aspect_ratio\": \"2:3|2:1\"\n  },\n  \"asset_plan\": {\n    \"hero_image_url\": \"string\",\n    \"supporting_image_urls\": [\"string\"]\n  },\n  \"render_notes\": {\n    \"text_to_render_verbatim\": {\n      \"headline\": \"string\",\n      \"cta\": \"string|null\"\n    },\n    \"negative_instructions\": [\"string\"]\n  }\n}",
              "type": "string"
            },
            {
              "id": "s1-g",
              "name": "poster_gen_user_template",
              "value": "Create a DALL·E poster prompt using ONLY these selected images:\n\nConcept: {poster_concept}\nSelected Images: {selected_images}\nGuidelines: {guidelines}\n\nReturn ONLY JSON matching the schema. No markdown. No extra text.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [250, 0],
      "name": "Step 1: Extract Webhook & Load Prompts"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s2-a",
              "name": "image_selection_user_prompt",
              "value": "={{ $json.image_selection_user_template.split('{poster_concept}').join(JSON.stringify($json.poster_concept)).split('{guidelines}').join(JSON.stringify($json.guidelines)).split('{image_urls}').join(JSON.stringify($json.image_urls)) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [500, 0],
      "name": "Step 2: Template Image Selection Prompt"
    },
