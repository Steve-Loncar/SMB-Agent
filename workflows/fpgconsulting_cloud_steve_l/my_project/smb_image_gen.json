              "name": "messages",
              "value": "={{[\n  {\n    role: 'system',\n    content: ($json.image_selection_system)\n  },\n  {\n    role: 'user',\n    content: \n      ($json.image_selection_user_template) +\n      '\\n\\n===== DATA INPUTS =====\\n\\n' +\n      'POSTER CONCEPT:\\n' +\n      JSON.stringify($json.poster_concept) +\n      '\\n\\nGUIDELINES:\\n' +\n      JSON.stringify($json.guidelines) +\n      '\\n\\nIMAGE URLS:\\n' +\n      JSON.stringify($json.image_urls)\n  }\n]}}"
