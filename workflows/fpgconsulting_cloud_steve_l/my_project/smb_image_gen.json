      "name": "Strip fences1"
    },
    {
      "parameters": {
        "jsCode": "const parsed = JSON.parse($json.no_fences);\nconst selectedImages = $('Build Stage 2 Prompt').item.json.selected_images || [];\nconst selectionNotes = $('Build Stage 2 Prompt').item.json.selection_notes || {};\n\n// Extract text content from the new schema\nconst textContent = parsed.text_content || {};\nconst headline = textContent.headline || '';\nconst supportingCopy = textContent.supporting_copy || '';\nconst cta = textContent.cta || '';\nconst textColour = textContent.text_colour || 'white';\nconst placement = textContent.placement_description || '';\n\nconst render_notes = {\n  text_content: textContent,\n  negative_instructions: parsed.render_notes?.negative_instructions\n};\n\n// Format-aware size for gpt-image-1\nconst orientation = parsed.layout_spec?.orientation || 'portrait';\nconst imageSize = orientation === 'landscape' ? '1536x1024' : '1024x1536';\n\n// Build the final prompt — reinforce text rendering at the end\nlet poster_prompt = parsed.poster_prompt || '';\n\n// Append text rendering reinforcement if headline exists\nif (headline) {\n  let textSuffix = `\\n\\nIMPORTANT — render this text exactly on the poster:`;\n  textSuffix += `\\nHEADLINE (large bold sans-serif, ${textColour}): \"${headline}\"`;\n  if (supportingCopy) textSuffix += `\\nSUPPORTING COPY (smaller, ${textColour}): \"${supportingCopy}\"`;\n  if (cta) textSuffix += `\\nCTA (compact, ${textColour}): \"${cta}\"`;\n  if (placement) textSuffix += `\\nPlacement: ${placement}`;\n  textSuffix += `\\nSpell every word exactly as shown. Clean professional sans-serif typography only.`;\n  poster_prompt += textSuffix;\n}\n\nreturn [{\n  json: {\n    poster_prompt,\n    image_size: imageSize,\n    poster_metadata: parsed,\n    selected_images: selectedImages,\n    selection_notes: selectionNotes,\n    render_notes,\n  }\n}];"
      },
