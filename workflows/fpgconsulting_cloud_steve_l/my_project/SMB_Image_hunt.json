    {
      "parameters": {
        "jsCode": "const candidates = $input.first().json.asset_candidates || [];\n\n// 1. Normalise URLs: strip tracking params, lowercase scheme+host\nfunction normaliseUrl(u) {\n  try {\n    const url = new URL(u);\n    // Strip common tracking params\n    ['utm_source','utm_medium','utm_campaign','utm_content','utm_term',\n     'fbclid','gclid','ref','_ga','mc_cid','mc_eid'].forEach(p => url.searchParams.delete(p));\n    // Strip trailing hash if empty\n    if (url.hash === '#') url.hash = '';\n    return url.href;\n  } catch { return u; }\n}\n\n// 2. Junk detection patterns\nconst JUNK_PATTERNS = [\n  /1x1/i, /spacer/i, /pixel/i, /blank\\./i, /tracking/i,\n  /favicon/i, /apple-touch-icon/i, /safari-pinned-tab/i,\n  /wp-emoji/i, /gravatar\\.com/i, /googletagmanager/i,\n  /facebook\\.com\\/tr/i, /analytics/i, /beacon/i,\n  /\\.gif$/i,  // most GIFs on business sites are tracking pixels\n  /data:image\\/svg/i, /data:image\\/gif/i,\n  /cookie/i, /gdpr/i, /consent/i\n];\nconst JUNK_ALT = [\n  /^$/,  // empty alt is suspicious but not always junk\n  /loading/i, /spinner/i, /arrow/i, /chevron/i, /caret/i,\n  /hamburger/i, /menu icon/i, /close/i, /search icon/i\n];\n\nfunction isJunk(c) {\n  const url = (c.url || '').toLowerCase();\n  const alt = (c.alt || '').toLowerCase();\n  const cls = (c.cls || '').toLowerCase();\n  const kind = (c.kind || '').toLowerCase();\n\n  // Skip data URIs (inline SVG UI elements)\n  if (url.startsWith('data:')) return true;\n\n  // Skip by URL pattern\n  if (JUNK_PATTERNS.some(p => p.test(url))) return true;\n\n  // Skip tiny icon classes\n  if (/icon-(?:arrow|chevron|caret|close|menu|search|social)/i.test(cls)) return true;\n\n  // Skip social media icons by alt\n  if (/^(facebook|twitter|instagram|linkedin|youtube|tiktok|pinterest)\\s*(icon|logo)?$/i.test(alt)) return true;\n\n  // Keep SVG inlines only if they look like logos\n  if (kind === 'svg_inline' && !/logo|brand|mark/i.test(alt + ' ' + cls)) return true;\n\n  return false;\n}\n\n// 3. Dedupe by normalised URL\nconst seen = new Set();\nconst cleaned = [];\nfor (const c of candidates) {\n  if (!c.url) continue;\n  const norm = normaliseUrl(c.url);\n  if (seen.has(norm)) continue;\n  if (isJunk(c)) continue;\n  seen.add(norm);\n  cleaned.push({ ...c, url: norm });\n}\n\n// 4. Cap at 120 candidates (LLM context budget)\nconst capped = cleaned.slice(0, 120);\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    asset_candidates: capped,\n    _filter_stats: {\n      input_count: candidates.length,\n      after_dedupe_and_filter: cleaned.length,\n      sent_to_llm: capped.length\n    }\n  }\n}];"
      },
