              "value": "={{\n  (() => {\n    const s = $json.step3_no_fences || '';\n    const start = s.indexOf('{');\n    const end = s.lastIndexOf('}');\n    if (start === -1 || end === -1 || end <= start) {\n      return s.trim();\n    }\n    return s.substring(start, end + 1).trim();\n  })()\n}}",
