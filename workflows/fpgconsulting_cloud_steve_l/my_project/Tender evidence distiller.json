              "name": "messages",
              "value": "={{ [ { role: 'system', content: $json.distiller_prompt }, { role: 'user', content: 'You are processing ONE document from docs[] (n8n has split docs into items).\\nTreat this as the ONLY document available.\\n\\nEVIDENCE_PACK_ID: ' + ($json.evidence_pack_id || '') + '\\nAUTHORITY: ' + ($json.authority_name || '') + '\\nDISTILL_PROFILE: ' + ($json.distill_profile || 'balanced') + '\\n\\nTENDER_QUESTION:\\n' + ($json.tender_question || '') + '\\n\\nDOCUMENT_METADATA:\\n- doc_id: ' + ($json.docs.doc_id || '') + '\\n- title: ' + ($json.docs.title || $json.docs.filename || '') + '\\n- do_not_distill: ' + ($json.docs.do_not_distill ? 'true' : 'false') + '\\n\\nDOCUMENT_TEXT:\\n' + ($json.docs.text || '') + '\\n\\nSTRICT RULES:\\n- Use ONLY DOCUMENT_TEXT.\\n- Do NOT add external sources.\\n- Do NOT invent citations.\\n- Output JSON ONLY per the system schema.\\n- Because this is ONE document, your manifest must include exactly ONE document.\\n' } ] }}"
            },
            {
              "name": "model",
              "value": "sonar-pro"
            },
            {
              "name": "max_tokens",
